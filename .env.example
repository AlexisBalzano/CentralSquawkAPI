# Copy to .env and fill in. .env is gitignored.

# Shared secret behind the plugin's SHA256(secret + controller callsign) token.
# Must match the AUTH_SECRET compiled into the EuroScope plugin.
# Leave empty to disable verification (local development only).
AUTH_SECRET=

# HMAC secret for the GitHub config webhook, matching the repository's webhook
# settings. Leave empty to skip signature verification (local development only).
GH_SECRET=

# Config repository. init-config.sh clones this into CONFIG_DIR at startup and
# the webhook pulls it in place afterwards.
CONFIG_REPO_URL=https://github.com/AlexisBalzano/CentralSquawk-config.git
CONFIG_BRANCH=main
CONFIG_DIR=/app/data

REDIS_URL=redis://redis:6379

PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# Datafeed cycles observed before the first allocation. The feed refreshes about
# every 15 s, so 2 means the first sweep runs against a complete picture.
WARMUP_CYCLES=2

VATSIM_DATAFEED_URL=https://data.vatsim.net/v3/vatsim-data.json
