# Copy to .env and fill in. .env is gitignored.

# Shared secret behind the plugin's SHA256(secret + controller callsign) token.
# Must match the AUTH_SECRET compiled into the EuroScope plugin.
# Leave empty to disable verification (local development only).
AUTH_SECRET=

# HMAC secret for the GitHub config webhook, matching the repository's webhook
# settings. Leave empty to skip signature verification (local development only).
GH_SECRET=

# Config repository. init-config.sh clones this into CONFIG_DIR at startup and
# the webhook pulls it in place afterwards.
CONFIG_REPO_URL=https://github.com/AlexisBalzano/CentralSquawk-config.git
CONFIG_BRANCH=main
CONFIG_DIR=/app/data

REDIS_URL=redis://redis:6379

PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# Datafeed cycles observed before the first allocation. The feed refreshes about
# every 15 s, so 2 means the first sweep runs against a complete picture.
WARMUP_CYCLES=2

VATSIM_DATAFEED_URL=https://data.vatsim.net/v3/vatsim-data.json

# A flight the plugin supplied ahead of the datafeed is dropped after this long
# if the feed never confirms it. Two feed generations is about 30 s, so this is
# generous several times over.
SEED_TTL_SEC=120

# Unconfirmed seeds one controller may hold at once. Caps what a buggy or
# hostile plugin can do with the one path that writes into the map.
SEED_MAX_PER_CONTROLLER=10

# Where observations come from.
#   vatsim  poll the datafeed. Production.
#   push    do not poll; a client supplies the picture on POST /api/feed.
#
# A sweatbox has no datafeed behind it, so a simulator session runs as a SECOND
# instance of this image with FEED_SOURCE=push. It may share the live Redis: the
# map is persisted under a key chosen by this setting (centralsquawk:assignments
# live, sweatbox:centralsquawk:assignments push), so neither instance ever
# restores the other's state. Two SIMULATOR instances on one Redis would share a
# key, though -- give a second one its own Redis. POST /api/feed is not
# registered at all unless this is set to push, so the production instance has
# no such route.
FEED_SOURCE=vatsim

# Push mode only: how long a feeder keeps the lease without pushing again.
# One client feeds a session at a time; the rest get 409 until it goes stale.
FEEDER_LEASE_SEC=45
