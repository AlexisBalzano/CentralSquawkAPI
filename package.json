{
  "name": "centralsquawk-api",
  "version": "0.1.0",
  "description": "Central SSR code assignment for the French FIRs",
  "author": "Alexis Balzano",
  "license": "ISC",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "docker": "docker compose down -v && docker compose up --build",
    "test": "node --import tsx --test test/engine.test.ts"
  },
  "dependencies": {
    "fastify": "^5.2.1",
    "redis": "^5.8.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=22"
  }
}
